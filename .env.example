# ============================================================
# Proposal Intelligence — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# LLM Configuration (Required for AI generation)
# ------------------------------------------------------------
# Supported providers: openai | gemini | anthropic | custom
#
# OpenAI (default):
LLM_PROVIDER=openai
LLM_API_KEY=sk-...your-openai-api-key...
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1

# Google Gemini:
# LLM_PROVIDER=gemini
# LLM_API_KEY=AIza...your-gemini-api-key...
# LLM_MODEL=gemini-1.5-pro

# Anthropic Claude:
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...your-anthropic-api-key...
# LLM_MODEL=claude-3-5-sonnet-20241022

# OpenAI-compatible custom endpoint (e.g. Groq, Together, Ollama):
# LLM_PROVIDER=custom
# LLM_API_KEY=your-key
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------
# Hindsight Cloud (Required — the agent's long-term memory)
# ------------------------------------------------------------
# Create an API key at https://ui.hindsight.vectorize.io (API Keys page).
# Recall, retain and reflect all go to Hindsight; without it the analyze and
# outcome steps return a clear "Hindsight not configured" error.
HINDSIGHT_API_KEY=hsk_...your-hindsight-cloud-key...
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=proposal-intelligence
# For a self-hosted server instead: HINDSIGHT_BASE_URL=http://localhost:8888 (API key optional)

# ------------------------------------------------------------
# Application Data Storage
# ------------------------------------------------------------
# On Vercel: connect Upstash Redis from the Vercel Marketplace; it sets these for you.
# KV_REST_API_URL=https://....upstash.io
# KV_REST_API_TOKEN=...
#
# Without Redis, a local JSON file is used (dev / single Node server):
# APP_DATA_PATH=./data/store.json
